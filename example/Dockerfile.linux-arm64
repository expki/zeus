# target older distro for wider glibc compatibility
FROM golang:bookworm

# Enable ARM64 architecture for cross-compilation libraries
RUN dpkg --add-architecture arm64

# Install build dependencies for both C++ libraries and Go
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libvulkan-dev:arm64 \
    glslc \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the entire zeus example source
COPY . .

# Build target
CMD ["sh", "-c", "CGO_ENABLED=1 GOOS=linux GOARCH=arm64 GOARM64=v8.0 CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ go build -o /output/example ."]
